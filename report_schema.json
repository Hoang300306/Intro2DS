{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Intro2DS stage summary",
  "description": "summary.json, one per scoring or training stage directory",
  "type": "object",
  "required": [
    "model",
    "assignee_id",
    "stage",
    "environment",
    "code",
    "run",
    "results"
  ],
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string"
    },
    "assignee_id": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "A1_env",
        "A2_reproduce",
        "A3_smoke",
        "B_retrain_released",
        "C_retrain_variants"
      ],
      "description": "which checkpoint part this summary belongs to"
    },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "torch",
        "cuda",
        "gpu",
        "lockfile"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "torch": {
          "type": "string"
        },
        "cuda": {
          "type": "string"
        },
        "gpu": {
          "type": "string",
          "description": "as nvidia-smi names it, plus memory"
        },
        "lockfile": {
          "type": "string",
          "description": "path to the lockfile in stage1_env/"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "code": {
      "type": "object",
      "required": [
        "upstream_url",
        "upstream_commit",
        "changes_diff_sha256",
        "changes_justified"
      ],
      "properties": {
        "upstream_url": {
          "type": "string"
        },
        "upstream_commit": {
          "type": "string",
          "minLength": 7
        },
        "changes_diff_sha256": {
          "type": "string",
          "description": "sha256 of code/changes.diff; empty diff is fine"
        },
        "changes_justified": {
          "type": "boolean",
          "description": "true if every hunk is justified in REPORT.md"
        },
        "frozen_sha256_file": {
          "type": "string",
          "description": "sha256 of code/frozen.sha256 itself. CI compares it across stages: the listing is generated once at checkpoint A and must be identical afterwards. The checksums inside it cover upstream files CI does not hold, so this is what catches a regenerated listing."
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "seed",
        "checkpoint_rule",
        "command_file",
        "wall_clock_hours",
        "gpu_hours"
      ],
      "properties": {
        "seed": {
          "type": "integer"
        },
        "checkpoint_rule": {
          "enum": [
            "best",
            "avg_last10",
            "last",
            "other"
          ]
        },
        "checkpoint_rule_source": {
          "type": "string",
          "description": "where upstream states it"
        },
        "checkpoint_sha256": {
          "type": "string"
        },
        "epochs": {
          "type": "integer"
        },
        "batch_size": {
          "type": "integer"
        },
        "update_freq": {
          "type": "integer"
        },
        "command_file": {
          "type": "string",
          "description": "path to code/run.sh"
        },
        "wall_clock_hours": {
          "type": "number"
        },
        "gpu_hours": {
          "type": "number"
        }
      }
    },
    "training_data": {
      "type": "object",
      "description": "required for B_retrain_released (split_id = 'released') and C_retrain_variants (split_id = the variant id)",
      "properties": {
        "split_id": {
          "type": "string",
          "description": "for stage5; 'released' for stage4"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "content_digest"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "description": "deprecated alias of content_digest; prefer content_digest"
              },
              "n_rows": {
                "type": "integer"
              },
              "n_groups": {
                "type": "integer"
              },
              "content_digest": {
                "type": "string",
                "description": "the digest apply_variant.py printed for this file, in full"
              }
            }
          }
        }
      }
    },
    "results": {
      "type": "array",
      "description": "one entry per benchmark; per-target values go in per_target.csv",
      "items": {
        "type": "object",
        "required": [
          "benchmark",
          "n_targets",
          "per_target_csv",
          "metrics"
        ],
        "properties": {
          "benchmark": {
            "type": "string"
          },
          "n_targets": {
            "type": "integer"
          },
          "per_target_csv": {
            "type": "string"
          },
          "metrics": {
            "type": "object",
            "description": "means over targets, as the upstream script reports them",
            "properties": {
              "auroc": {
                "type": "number"
              },
              "bedroc": {
                "type": "number"
              },
              "ef_0.005": {
                "type": "number"
              },
              "ef_0.01": {
                "type": "number"
              },
              "ef_0.02": {
                "type": "number"
              },
              "ef_0.05": {
                "type": "number"
              }
            }
          },
          "published_reference": {
            "type": "object",
            "description": "stage2 only: the paper's number and where it is stated",
            "properties": {
              "metric": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "source": {
                "type": "string"
              },
              "relative_gap_pct": {
                "type": "number"
              },
              "gate": {
                "type": "boolean",
                "description": "true on exactly one result at A2_reproduce: the benchmark and metric your sheet told you to name. The 10 % gate applies to this one alone."
              },
              "blocked": {
                "type": "string",
                "description": "set only when no published number is reachable from published artifacts -- say which artifact is missing and where you looked. The gated entry then passes on this explanation instead of on relative_gap_pct, and relative_gap_pct is not required. Never use this because your number came out wrong."
              }
            },
            "required": [
              "metric",
              "source",
              "value"
            ]
          },
          "bedroc_alpha": {
            "type": "number",
            "description": "the alpha your code passes to CalcBEDROC (80.5 and 85 are both in use upstream). Read it out of the code; a bedroc at one alpha is not comparable with a bedroc at another."
          },
          "checkpoint_sha256": {
            "type": "string",
            "description": "the SHA256 of the checkpoint this benchmark was scored with. Only needed when one stage used more than one checkpoint; otherwise run.checkpoint_sha256 covers it."
          }
        }
      }
    },
    "problems": {
      "type": "array",
      "description": "anything that did not work; an honest non-reproduction is a valid result",
      "items": {
        "type": "string"
      }
    }
  }
}
